# Copy to .env and fill in only what you need. Every setting is optional.
# Variables set in the real environment take precedence over this file.

# General
# HOOKLINE_LOG_LEVEL=WARNING
# HOOKLINE_LOG_FORMAT=text
# HOOKLINE_AI_ENABLED=true
# HOOKLINE_CONFIG=hookline.toml

# Language model (local Ollama is the default and needs no key)
# HOOKLINE_LLM__PROVIDER=ollama
# HOOKLINE_LLM__OLLAMA_URL=http://localhost:11434
# HOOKLINE_LLM__OLLAMA_MODEL=llama3.1:8b
# HOOKLINE_LLM__ANTHROPIC_MODEL=claude-opus-5-5
# HOOKLINE_LLM__REDACTION=auto

# Deterministic checks (lists are JSON arrays)
# HOOKLINE_CHECKS__PROTECTED_DOMAINS=["example.com","example.org"]
# HOOKLINE_CHECKS__TRUSTED_AUTHSERV_IDS=["mx1.example.com"]

# Anthropic API (only used when HOOKLINE_LLM__PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Threat intelligence (each provider is used only when its key is set)
# Free keys: https://auth.abuse.ch/ , https://www.abuseipdb.com/ ,
# https://www.virustotal.com/
URLHAUS_AUTH_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
# HOOKLINE_THREAT_INTEL__ENABLED=true
# HOOKLINE_THREAT_INTEL__CACHE_DIR=.hookline-cache
